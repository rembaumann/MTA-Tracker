# Copy this file to .env and fill in the values you use.
# .env is gitignored. install-pi.sh copies this file once if .env is missing.
# The systemd service loads .env. Restart the service after you change it:
#   sudo systemctl restart mta-tracker.service

# NYC subway GTFS-RT feeds are public. An API key is not required
# (checked against api-endpoint.mta.info on 2026-10-21; a keyless GET
# returns the protobuf feed). If you set a key anyway, it is sent as
# the x-api-key header.
MTA_API_KEY=

# Optional. Shows the temperature on the board via OpenWeatherMap.
# Create a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
